# 啟動 sherryserver 所需
SystemName=YouTubeLiveChatExample
PORT=8080
DocumentRoot=www/html
TemplateRoot=www/template
OriginAllowList=http://127.0.0.1:8080
AllowMethods=GET;POST

# 必填，至少 32 bytes
SessionCookieAuthKey=replace-with-at-least-32-random-bytes
# 可選，長度需為 16/24/32
# SessionCookieEncryptionKey=replace-with-32-random-bytes

# 範例應用設定
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_ID=
EXTERNAL_WS_URL=ws://127.0.0.1:9000/ws
