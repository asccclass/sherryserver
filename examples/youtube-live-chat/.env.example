# 啟動 sherryserver 所需
SystemName=YouTubeLiveChatExample
PORT=8080
DocumentRoot=www/html
TemplateRoot=www/template
OriginAllowList=http://127.0.0.1:8080
AllowMethods=GET;POST

# 必填，至少 32 bytes
SessionCookieAuthKey=replace-with-at-least-32-random-bytes

# 預設 HTTP。若使用固定憑證，維持 false 並填入下列兩個路徑。
TLSAutoEnabled=false
# sslCertification=/app/certs/fullchain.pem
# sslKeyfile=/app/certs/privkey.pem
# 自動 TLS：設為 true，移除固定憑證設定，將外部 TCP 443 導向 PORT。
# 同時更新 OriginAllowList，使其符合 HTTPS 網址。
# TLSAutoDomains=example.com,www.example.com
# TLSAutoCacheDir=/app/data/autocert
# TLSAutoEmail=admin@example.com
# 閱讀並同意 CA 條款後才設為 true。
# TLSAutoAcceptTOS=true
# 先以 staging 驗收，完成後移除此行切換正式 CA（快取會分開保存）。
# TLSAutoDirectoryURL=https://acme-staging-v02.api.letsencrypt.org/directory
# 可選，長度需為 16/24/32
# SessionCookieEncryptionKey=replace-with-32-random-bytes

# 範例應用設定
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_ID=
EXTERNAL_WS_URL=ws://127.0.0.1:9000/ws
# 可選，逗號分隔允許的 host 清單；若留空則預設只允許 EXTERNAL_WS_URL 的 host
# EXTERNAL_WS_ALLOWED_HOSTS=127.0.0.1,example.com
